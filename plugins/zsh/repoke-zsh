#!/bin/sh
# repoke plugin for zsh's startup files, protocol 1: https://github.com/paveldelpozo/repoke/blob/main/docs/plugins.md
# zsh itself is updated by the package manager that installed it; this only lets `repoke export`
# carry its config files to another machine (repoke 0.7 or later).
set -eu

case "${1:-}" in
  describe)
    # zsh reads its startup files from $ZDOTDIR when set; config paths are relative to $HOME.
    dir=
    case "${ZDOTDIR:-}" in
      "$HOME"/?*) dir="${ZDOTDIR#"$HOME"/}/" ;;
    esac
    files=
    for f in .zshenv .zprofile .zshrc .zlogin .zlogout .p10k.zsh; do
      files="$files${files:+,}\"$dir$f\""
    done
    # .zshenv in $HOME is what points zsh at $ZDOTDIR, so it travels too.
    [ -n "$dir" ] && files="$files,\".zshenv\""
    printf '{"protocol":1,"id":"zsh","name":"zsh config","config":[%s]}\n' "$files"
    ;;
  detect)
    if command -v zsh >/dev/null 2>&1; then
      printf '{"installed":true,"version":"%s"}\n' "$(zsh --version | awk '{print $2}')"
    else
      echo '{"installed":false}'
    fi
    ;;
  outdated)
    echo '[]'
    ;;
  upgrade)
    ;;
  *)
    echo "usage: $0 describe|detect|outdated|upgrade" >&2
    exit 2
    ;;
esac
